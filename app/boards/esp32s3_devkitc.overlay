#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

/ {
    aliases {
        pwm-led0 = &pwm_led_0;
        custom-driver = &my_driver;
    };
    
    pwmleds {
        compatible = "pwm-leds";
        pwm_led_0: pwm_led_0 {
            pwms = <&ledc0 0 5000 PWM_POLARITY_NORMAL>;
            label = "S3 External LED on GPIO 5";
        };
    };
    
    my_driver: my_driver {
        compatible = "our,driver";
        status = "okay";
        /* Map GPIO 5 so the custom sensor driver can manipulate it */
        gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
    };
};

&pinctrl {
    ledc0_default: ledc0_default {
        group1 {
            pinmux = <LEDC_CH0_GPIO5>;
            output-enable;
        };
    };
};

&ledc0 {
    pinctrl-0 = <&ledc0_default>;
    pinctrl-names = "default";
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    
    channel0@0 {
        reg = <0>;
        timer = <0>;
    };
};